{
  "name": "brook",
  "version": "0.1.0",
  "description": "Fleet overwatch — a sleeping guardian for Rob's AI fleet",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage && node scripts/verify-coverage-scope.mjs",
    "local:gate": "npm run format:check && npm run lint && npm run typecheck && npm run coverage"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261031.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "5.1.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
